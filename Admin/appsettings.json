{
  "PortalSettings": {
    "ApiBaseUrl": "http://localhost:5080/",
    "SessionIdleHours": 12,
    "StatusPollSeconds": 30,
    "ApiTimeoutSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
