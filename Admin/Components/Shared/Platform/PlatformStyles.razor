@* Styles of the v1.1.4 platform screens (users.js / history.js / shared.js / feedback.js) on top of app.css. *@
<style>
    .pg-title { font-family: var(--font-brand); font-size: 26px; font-weight: 800; color: var(--vmm-navy); letter-spacing: -0.3px; line-height: 1.1; }
    .pg-sub { font-size: 12px; color: var(--ink3); margin-top: 4px; line-height: 1.6; }
    .pf-h1 { margin-bottom: 18px; display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .pf-h1 > .pf-h1-l { flex: 1; min-width: 260px; }
    .pf-bar { height: 3px; width: 60px; background: linear-gradient(90deg, var(--vmm-pink), var(--vmm-cyan)); border-radius: 2px; margin: 5px 0 6px; }

    .btn-pri { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: linear-gradient(135deg, #E8006E, #c4005c); color: #fff; border: none; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: var(--font); box-shadow: 0 3px 12px rgba(232,0,110,.3); white-space: nowrap; }
    .btn-pri:hover { box-shadow: 0 5px 18px rgba(232,0,110,.45); }
    .btn-pri:disabled { background: var(--ink4); cursor: not-allowed; box-shadow: none; }
    .btn-sec { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; background: #fff; color: var(--ink2); border: 1.5px solid var(--brd2); border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; font-family: var(--font); white-space: nowrap; }
    .btn-sec:hover { background: var(--sur2); border-color: var(--vmm-navy-m); color: var(--vmm-navy); }
    .btn-sm { font-size: 11px; padding: 4px 10px; }
    .btn-danger { color: #DC2626 !important; border-color: #FECACA !important; }

    .pf-pills { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .pf-pill { padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: var(--font); border: 1.5px solid var(--brd2); background: #fff; color: var(--ink2); }
    .pf-pill.on { border-color: var(--vmm-pink); background: var(--vmm-pink); color: #fff; }
    .pf-pill .cnt { opacity: .8; font-weight: 500; }
    .pf-pill.navy.on { border-color: #1A4FAF; background: #1A4FAF; }

    .pf-in { padding: 7px 10px; border: 1.5px solid var(--brd2); border-radius: 7px; font-family: var(--font); font-size: 12px; color: var(--ink); background: #fff; box-sizing: border-box; }
    .pf-in:focus { outline: none; border-color: var(--vmm-pink); }
    .pf-lbl { font-size: 10px; font-weight: 700; color: var(--ink3); text-transform: uppercase; margin-bottom: 4px; }
    .pf-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }
    .pf-count { font-size: 11.5px; color: var(--ink2); }
    .pf-note { font-size: 11.5px; color: var(--ink2); margin-bottom: 10px; line-height: 1.6; }

    .pf-empty { padding: 40px; text-align: center; color: var(--ink3); }
    .pf-err { padding: 30px; color: #DC2626; }
    .pf-tbl-card { padding: 0 !important; overflow: hidden; }
    .pf-tbl-wrap { overflow-x: auto; max-height: 70vh; }
    .pf-tbl-card .sum-tbl th { z-index: 1; }
    .pf-tbl-card .sum-tbl td { vertical-align: top; }
    .pf-mono { font-family: var(--mono); }
    .pf-id { font-family: var(--mono); font-weight: 700; color: var(--vmm-pink); white-space: nowrap; cursor: pointer; text-decoration: underline; background: none; border: none; padding: 0; font-size: inherit; }
    .pf-nowrap { white-space: nowrap; }
    .pf-small { font-size: 11px; }
    .pf-muted { color: var(--ink3); }

    .pf-dp { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 10.5px; font-weight: 700; white-space: nowrap; }
    .pf-dp.dp-allow { background: linear-gradient(135deg,#dcfce7,#bbf7d0); color: #14532d; border: 1px solid #86efac; }
    .pf-dp.dp-reduce { background: linear-gradient(135deg,#fffbeb,#fef9c3); color: #78350f; border: 1px solid #fde68a; }
    .pf-dp.dp-watch { background: linear-gradient(135deg,#fef2f2,#ffe4e6); color: #7f1d1d; border: 1px solid #fecaca; }
    .pf-dp.dp-hold { background: linear-gradient(135deg,#1a0010,#2d0020); color: #ff7eb3; border: 1px solid #990040; }
    .pf-dp.dp-block { background: linear-gradient(135deg,#1a0a0a,#2d1010); color: #FF9999; border: 1px solid #991111; }
    .pf-dp.dp-nodata { background: var(--sur2); color: var(--ink3); border: 1px solid var(--brd2); }
    .pf-abadge { margin-top: 4px; display: inline-block; font-size: 9.5px; font-weight: 700; border-radius: 8px; padding: 2px 7px; }

    .eng-tag { display: inline-block; padding: 2px 8px; border-radius: 6px; font-weight: 700; white-space: nowrap; }
    .et-b { background: linear-gradient(135deg,#e0f6ff,#bfecff); color: #0a6b99; border: 1px solid #7dd3fc; }
    .et-a { background: linear-gradient(135deg,var(--vmm-navy-l),#dce8ff); color: var(--vmm-navy-d); border: 1px solid var(--vmm-navy-m); }
    .et-new { background: linear-gradient(135deg,#f5f3ff,#ede9fe); color: #4c1d95; border: 1px solid var(--purm); }

    .sum-sec { background: var(--sur); border: 1px solid var(--brd); border-radius: var(--r); box-shadow: var(--sh); overflow: hidden; margin-bottom: 16px; }
    .sum-hdr { background: linear-gradient(135deg, var(--vmm-navy-d), var(--vmm-navy)); padding: 10px 16px; display: flex; align-items: center; gap: 10px; }
    .sum-hdr-t { font-size: 14px; font-weight: 700; color: #fff; font-family: var(--font-brand); letter-spacing: .02em; }
    .sum-hdr .mine { margin-left: auto; margin-right: 12px; font-size: 11px; color: rgba(255,255,255,.85); display: flex; align-items: center; gap: 5px; cursor: pointer; }

    .role-chip { display: inline-block; margin: 1px 3px 1px 0; padding: 1px 8px; border-radius: 9px; font-size: 10px; font-weight: 700; }
    .file-chip { display: inline-block; margin: 1px 3px 1px 0; padding: 1px 7px; border-radius: 9px; font-size: 10px; font-weight: 600; }
    .fb-badge { padding: 2px 9px; border-radius: 9px; font-size: 10.5px; font-weight: 700; }
    .pf-kv .k { font-size: 10px; color: var(--ink3); text-transform: uppercase; font-weight: 700; }
</style>
