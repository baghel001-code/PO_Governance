@page "/Account/Login"
@layout AccountLayout
@attribute [AllowAnonymous]
@using Admin.Auth

<PageTitle>Sign in · VMM PO Governance</PageTitle>

<div class="pg-login-sub">Sign in with your company email</div>

@* A plain form: it posts to AccountEndpoints (/Account/SignIn), which sets the cookie and redirects. *@
<form method="post" action="@AccountEndpoints.SignInPath">
    <AntiforgeryToken />
    <input type="hidden" name="Next" value="@AccountEndpoints.SafeNext(Next)" />
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="pg-msg err">@Error</div>
    }
    <div class="pg-field">
        <label for="email">Email</label>
        <input id="email" name="Email" type="email" value="@Email" autocomplete="username" required placeholder="name@vishalwholesale.co.in" autofocus="@string.IsNullOrEmpty(Email)" />
    </div>
    <div class="pg-field">
        <label for="pw">Password</label>
        <input id="pw" name="Password" type="password" autocomplete="current-password" required autofocus="@(!string.IsNullOrEmpty(Email))" />
    </div>
    <button class="pg-primary" type="submit">Sign in</button>
    <div class="pg-foot">Forgot your password? Ask the administrator to reset it.<br />First time here? Your starting password was given to you by the administrator.</div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "next")] private string? Next { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }
}
