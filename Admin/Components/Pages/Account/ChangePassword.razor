@page "/Account/ChangePassword"
@layout AccountLayout
@using System.Text.RegularExpressions
@using Admin.Auth
@inject PortalAuthService AuthService
@inject IAPICallService Api
@inject NavigationManager Nav

<PageTitle>Change password · VMM PO Governance</PageTitle>

<div class="pg-login-sub">@(Forced ? "Set your own password" : "Change your password")</div>

<EditForm Model="Input" FormName="change-password" OnValidSubmit="SaveAsync" method="post">
    @if (Forced)
    {
        <div class="pg-msg info">For security, please set your own password before continuing.</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="pg-msg err">@_error</div>
    }
    <div class="pg-field">
        <label for="old">Current password</label>
        <InputText id="old" type="password" @bind-Value="Input.Old" autocomplete="current-password" required />
    </div>
    <div class="pg-field">
        <label for="new1">New password</label>
        <InputText id="new1" type="password" @bind-Value="Input.New" autocomplete="new-password" required />
    </div>
    <ul class="pg-rules">
        <li>At least @_minLength characters</li>
        <li>At least one letter and one number</li>
        <li>Not the default password</li>
    </ul>
    <div class="pg-field">
        <label for="new2">Confirm new password</label>
        <InputText id="new2" type="password" @bind-Value="Input.Confirm" autocomplete="new-password" required />
    </div>
    <button class="pg-primary" type="submit">Save password &amp; continue</button>
</EditForm>
<form method="post" action="@(Forced ? "/Account/Logout" : "/")" class="pg-foot">
    <AntiforgeryToken />
    @if (Forced)
    {
        <button type="submit" class="pg-link">Sign out</button>
    }
    else
    {
        <a class="pg-link" href="/">← Back to the portal</a>
    }
</form>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangePasswordInput Input { get; set; } = new();
    [SupplyParameterFromQuery(Name = "forced")] private string? ForcedQuery { get; set; }
    [SupplyParameterFromQuery(Name = "next")] private string? Next { get; set; }
    private string? _error;
    private int _minLength = 8;

    private bool Forced => ForcedQuery == "1" || HttpContext.User.FindFirst(CustomClaimTypes.MustChange)?.Value == "true";

    private string Token => HttpContext.User.FindFirst(CustomClaimTypes.SessionToken)?.Value ?? "";

    protected override async Task OnInitializedAsync()
    {
        var me = await Api.SendWithTokenAsync<JsonElement>(HttpMethod.Get, "api/v1/auth/me", Token);
        if (me.IsSuccess && me.Data.ValueKind == JsonValueKind.Object && me.Data.TryGetProperty("passwordMinLength", out var n) && n.ValueKind == JsonValueKind.Number)
            _minLength = n.GetInt32();
    }

    private async Task SaveAsync()
    {
        var v = Input.New ?? "";
        if (v.Length < _minLength || !Regex.IsMatch(v, "[A-Za-z]") || !Regex.IsMatch(v, @"\d") || v == "1234")
        { _error = "The new password does not meet the rules below."; return; }
        if (v != Input.Confirm) { _error = "The two new passwords do not match."; return; }
        var res = await Api.SendWithTokenAsync<JsonElement>(HttpMethod.Post, "api/v1/auth/change-password", Token, new { old = Input.Old, @new = v });
        if (!res.IsSuccess) { _error = string.IsNullOrEmpty(res.ResponseMessage) ? "Could not change password" : res.ResponseMessage; return; }
        await AuthService.RefreshAsync(HttpContext, Token);
        var next = !string.IsNullOrEmpty(Next) && Next.StartsWith('/') && !Next.StartsWith("//") && !Next.StartsWith("/Account") ? Next : "/";
        Nav.NavigateTo(next, forceLoad: true);
    }
}
