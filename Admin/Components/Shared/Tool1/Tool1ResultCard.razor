@* index.html renderResult(r): one Tool 1 result card, laid out from Tool1CardDto (all texts and colours come
   from the server). The Watch List approval badge (shared.js approvalBadge) sits under the decision pill. *@
@inject IDialogService Dialogs

<div class="res-card" data-testid="result-card" data-decision="@Card.Decision">
    <div class="res-hdr">
        <div class="rh-l">
            <div class="rh-num">@(Card.CheckOnly ? "✓" : Card.Id.ToString())</div>
            <div style="min-width:0">
                <div class="rh-title">
                    <span class="rh-gm">@Card.Gm</span>
                    <span class="rh-col">@Card.Colour</span>
                    <span class="rh-chip" style="background:@Card.EngineBg;color:@Card.EngineColour">@Card.EngineLabel</span>
                    @if (!string.IsNullOrEmpty(Card.OptionTypeChip))
                    {
                        <span class="rh-ot">@Card.OptionTypeChip</span>
                    }
                </div>
                @if (Card.ArtLine is { } art)
                {
                    @* v1.1.6 S7: Generic Article description (grey) and vendor *@
                    <div class="rh-art" title="@art.Title" data-testid="art-line">@art.Description@if (art.Vendor != null)
                        {
                            <span class="rh-art-v"> · @art.Vendor</span>
                        }</div>
                }
                <div class="rh-sub">@Card.SubLine</div>
            </div>
        </div>
        <div class="rh-r">
            <div class="rh-dec" style="background:@Card.DecisionBg;color:@Card.DecisionColour;border-color:@Card.DecisionBorder" data-testid="decision">@Card.Decision</div>
            @if (Request != null)
            {
                <ApprovalBadge Request="Request" />
            }
        </div>
    </div>

    <div class="res-body">
        @if (Card.CheckOnly)
        {
            <div style="margin:0 0 10px;padding:8px 12px;border-radius:8px;background:#FFF1D6;border:1px solid #F5D79E;color:#6B4500;font-size:12px;font-weight:600" data-testid="check-only">
                Check only – not saved, uses no capacity. Raise the request in SAP.
            </div>
        }
        @if (Card.Explain != null)
        {
            @* v1.1.6 S8 (explain.js addLink) *@
            <div class="xp-reslink">
                <span class="xp-link" role="button" tabindex="0" @onclick="() => _explain = Card.Explain" @onkeydown="OpenOnEnter" data-testid="explain-link">How was this number worked out? →</span>
                <span style="color:#6B7280">(steps, Excel with formulas)</span>
            </div>
        }
        @if (Card.BobsSiblings is { Count: > 0 } sibs)
        {
            <BobsSiblings List="sibs" />
        }
        <div class="t1-chips">
            @for (var i = 0; i < Card.Chips.Count; i++)
            {
                var ch = Card.Chips[i];
                @if (i > 0)
                {
                    <div class="t1-chip-sep"></div>
                }
                <div class="t1-chip">
                    <span class="t1-chip-k">@ch.Key</span>
                    <span class="t1-chip-v" style="@(ch.Colour != null ? "color:" + ch.Colour : "")">@ch.Value</span>
                </div>
            }
        </div>

        @if (Card.MraIn is { } mra)
        {
            @* v1.1.7: open MRAs from SAP counted in this colour (shown so the number can be followed) *@
            var months = mra.ByMon.Keys.OrderBy(k => { var p = k.Split('.'); return p.Length == 2 && int.TryParse(p[0], out var m) && int.TryParse(p[1], out var y) ? y * 12 + m : 0; });
            <div style="margin:0 0 12px;padding:9px 13px;border-radius:9px;background:#EEF3FC;border:1px solid #C9D7F0;font-size:11.5px;color:#1A2B4A;line-height:1.6" data-testid="mra-counted">
                <b>Open MRAs from SAP counted in this colour</b> (added to the released POs in Step 3):
                @string.Join(" · ", months.Select(k => MonLabel(k) + " " + DecisionEngine.Common.Js.Fmt(mra.ByMon[k])))
                <br />
                <span style="color:#56637A">
                    @string.Join(" · ", mra.Items.Take(8).Select(it => (it.Type == "PO" ? "PO " : "MRA ") + it.No + " · " + DecisionEngine.Common.Js.Fmt(it.Qty) +
                        (it.Type == "PO" ? " (live PO change)" : " (level " + it.Level + (it.Live ? ", live" : "") + ")")))@(mra.Items.Count > 8 ? " …" : "")
                </span>
            </div>
        }
        @if (Card.B != null)
        {
            <Tool1CardB B="Card.B" />
        }
        @if (Card.A != null)
        {
            <Tool1CardA A="Card.A" />
        }

        <div class="t1-reason" style="background:@Card.DecisionBg;border-color:@Card.DecisionBorder;border-left-color:@Card.DecisionColour;color:@Card.DecisionColour" data-testid="reason">
            <strong>@Card.ReasonTitle</strong><br />
            <span>@(string.IsNullOrEmpty(Card.Reason) ? "—" : Card.Reason)</span>
        </div>

        @if (Card.LaterCaution is { } lc)
        {
            @* v1.1.6 S3: later-PO caution (information only) *@
            <div class="later-po-caution" data-testid="later-po-caution">
                <strong class="lpc-k">Caution</strong><br />
                @foreach (var s in lc.Segments)
                {
                    if (s.Bold)
                    {
                        <strong>@s.Text</strong>
                    }
                    else
                    {
                        @s.Text
                    }
                }
                <div class="lpc-note">@lc.Note</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Card.ColourReason))
        {
            @* v1.1.6 S5: the buyer's reason *@
            <div class="t1-colour-reason" data-testid="colour-reason-box">
                <strong>Why introduce this colour? (buyer)</strong><br />@Card.ColourReason
            </div>
        }

        <StrCautionBox Caution="Card.StrCaution" />
    </div>

    <div class="t1-foot">
        <span class="t1-foot-hint">@Card.FooterHint</span>
        <button class="rec-btn" @onclick="OpenRecommendation" data-testid="view-rec">📊 View Recommendation</button>
    </div>
</div>

<ExplainPanel Explain="_explain" OnClose="() => _explain = null" />

@code {
    [Parameter, EditorRequired] public Tool1CardDto Card { get; set; } = default!;

    private static readonly string[] Mn = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    private static string MonLabel(string mk) { var p = mk.Split('.'); return p.Length == 2 && int.TryParse(p[0], out var m) && m is >= 1 and <= 12 ? Mn[m - 1] + " " + p[1] : mk; }
    /// <summary>The saved request (for the approval badge); null before it is saved.</summary>
    [Parameter] public JsonObject? Request { get; set; }

    private SingleExplainDto? _explain;

    private void OpenOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _explain = Card.Explain;
    }

    // openRec(btn): the bucket of the card (MC / MRP / Brand / Flag / Div / MC desc) and its engine.
    private Task OpenRecommendation() =>
        RecommendationDialog.ShowAsync(Dialogs, new RecommendationRequestDto
        {
            // The card's bucket is what openRec used; the GM only when the bucket is unknown.
            Gm = string.IsNullOrEmpty(Card.RecInfo.McCd) ? Card.Gm : null,
            Engine = Card.RecEngine,
            McCd = Card.RecInfo.McCd,
            Mrp = Card.RecInfo.Mrp,
            Brand = Card.RecInfo.Brand,
            Flag = Card.RecInfo.Flag,
            Div = Card.RecInfo.Div,
            McDesc = Card.RecInfo.McDesc,
        });
}
