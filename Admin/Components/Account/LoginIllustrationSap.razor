@* Slide 3 art: SAP asks about a PO, the tool answers in seconds with a verdict and a link. Styled by wwwroot/css/auth.css. *@
<svg class="pga-art" viewBox="0 0 480 360" role="img" aria-label="SAP sends a purchase order and the tool answers with a verdict in seconds">
    <ellipse cx="240" cy="330" rx="210" ry="16" class="a-shadow" />
    <!-- SAP server -->
    <g>
        <rect x="40" y="96" width="120" height="170" rx="12" class="a-screen" />
        <rect x="56" y="114" width="88" height="22" rx="5" class="a-sap" />
        <text x="100" y="130" text-anchor="middle" class="a-sap-text">SAP</text>
        <rect x="56" y="150" width="88" height="10" rx="3" class="a-stand" />
        <rect x="56" y="168" width="88" height="10" rx="3" class="a-stand" />
        <rect x="56" y="186" width="88" height="10" rx="3" class="a-stand" />
        <circle cx="64" cy="246" r="4" class="a-led" /><circle cx="78" cy="246" r="4" class="a-led" />
    </g>
    <!-- request / answer arrows -->
    <g class="a-drive">
        <path d="M172 150 H 292" class="a-flow" /><path d="M284 142 l10 8 l-10 8" class="a-flow-head" />
        <rect x="196" y="126" width="74" height="16" rx="8" class="a-pill" />
        <text x="233" y="137" text-anchor="middle" class="a-pill-text">PO 4500123</text>
    </g>
    <g class="a-drive a-delay">
        <path d="M292 214 H 172" class="a-flow back" /><path d="M180 206 l-10 8 l10 8" class="a-flow-head back" />
        <rect x="200" y="222" width="66" height="16" rx="8" class="a-pill" />
        <text x="233" y="233" text-anchor="middle" class="a-pill-text">0.8 s</text>
    </g>
    <!-- the tool's answer -->
    <g class="a-float">
        <rect x="300" y="80" width="150" height="196" rx="14" class="a-paper a-card-shadow" />
        <rect x="316" y="98" width="70" height="8" rx="4" class="a-ink" />
        <rect x="316" y="114" width="100" height="6" rx="3" class="a-line" />
        <circle cx="375" cy="170" r="34" class="a-ok" />
        <path d="M360 170 l10 10 l20 -22" class="a-tick big" />
        <rect x="330" y="216" width="90" height="18" rx="9" class="a-approve" />
        <text x="375" y="229" text-anchor="middle" class="a-approve-text">APPROVE</text>
        <rect x="330" y="244" width="90" height="6" rx="3" class="a-line" />
        <rect x="346" y="256" width="58" height="6" rx="3" class="a-link" />
    </g>
    <circle cx="30" cy="70" r="3" class="a-dot" />
    <circle cx="460" cy="300" r="4" class="a-dot" />
</svg>
