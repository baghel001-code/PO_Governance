@page "/Account/ChangePassword"
@layout AccountLayout
@using Admin.Auth
@inject PortalAuthService AuthService

<PageTitle>Change password · VMM PO Governance</PageTitle>

@if (IsHrms)
{
    <div class="pg-login-sub">Your password is your HRMS password</div>
    <div class="pg-msg info">You sign in with your Employee ID and the same password as MyVishal (HRMS). Change or unlock it there; this portal does not keep a password for you.</div>
    @if (!string.IsNullOrEmpty(_hrmsUrl))
    {
        <a class="pg-primary" style="display:block;text-align:center;text-decoration:none" href="@_hrmsUrl" target="_blank" rel="noopener">Open MyVishal ↗</a>
    }
    <div class="pg-foot"><a class="pg-link" href="/">← Back to the portal</a></div>
    return;
}

<div class="pg-login-sub">@(Forced ? "Set your own password" : "Change your password")</div>

@* A plain form: it posts to AccountEndpoints (/Account/SavePassword), which re-issues the cookie and redirects. *@
<form method="post" action="@AccountEndpoints.SavePasswordPath">
    <AntiforgeryToken />
    <input type="hidden" name="Next" value="@AccountEndpoints.SafeNext(Next)" />
    <input type="hidden" name="Forced" value="@(Forced ? "1" : "0")" />
    <input type="hidden" name="MinLength" value="@_minLength" />
    @if (Forced)
    {
        <div class="pg-msg info">For security, please set your own password before continuing.</div>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="pg-msg err">@Error</div>
    }
    <div class="pg-field">
        <label for="old">Current password</label>
        <input id="old" name="Old" type="password" autocomplete="current-password" required autofocus />
    </div>
    <div class="pg-field">
        <label for="new1">New password</label>
        <input id="new1" name="New" type="password" autocomplete="new-password" required />
    </div>
    <ul class="pg-rules">
        <li>At least @_minLength characters</li>
        <li>At least one letter and one number</li>
        <li>Not the default password</li>
    </ul>
    <div class="pg-field">
        <label for="new2">Confirm new password</label>
        <input id="new2" name="Confirm" type="password" autocomplete="new-password" required />
    </div>
    <button class="pg-primary" type="submit">Save password &amp; continue</button>
</form>
<form method="post" action="/Account/Logout" class="pg-foot">
    <AntiforgeryToken />
    @if (Forced)
    {
        <button type="submit" class="pg-link">Sign out</button>
    }
    else
    {
        <a class="pg-link" href="/">← Back to the portal</a>
    }
</form>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "forced")] private string? ForcedQuery { get; set; }
    [SupplyParameterFromQuery(Name = "next")] private string? Next { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    private int _minLength = 8;
    private string? _hrmsUrl;
    private bool IsHrms => HttpContext.User.FindFirst(CustomClaimTypes.LoginType)?.Value == "hrms";

    private bool Forced => ForcedQuery == "1" || HttpContext.User.FindFirst(CustomClaimTypes.MustChange)?.Value == "true";

    protected override async Task OnInitializedAsync()
    {
        var token = HttpContext.User.FindFirst(CustomClaimTypes.SessionToken)?.Value ?? "";
        var me = await AuthService.MeAsync(token);
        if (me.IsSuccess && me.Data is { PasswordMinLength: > 0 } m) _minLength = m.PasswordMinLength;
        _hrmsUrl = me.Data?.HrmsPasswordUrl;
    }
}
