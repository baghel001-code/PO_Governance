@* Data Setup → MRA status. The morning MRA file is merged into the MRA lines (PO_MRA_UPLOAD: added / updated, lines not in the file stay); during the day SAP updates the
   lines through POST /api/sap/v1/mra-status. Summary per status, search / filter / page, and the SAP changes of one MRA. *@
@using Domain.Entities.Sap
@using Admin.Services.Platform
@inject ISnackbar Snackbar

<PlatformStyles />
<style>
    .mra-chip { border: 1px solid var(--brd); background: #fff; border-radius: 14px; padding: 3px 10px; font-size: 11.5px; cursor: pointer; color: var(--ink2); }
    .mra-chip.on { background: var(--vmm-navy); border-color: var(--vmm-navy); color: #fff; font-weight: 700; }
    .ds-card-hdr .btn-sec, .ds-card-hdr .btn-pri { font-size: 11.5px; }
</style>

<div class="ds-card" data-testid="mra-panel">
    <div class="ds-card-hdr" style="display:flex;align-items:center;gap:10px">
        <span>🧾 MRA Status</span>
        <span style="font-weight:400;opacity:.8;font-size:11.5px">morning file here · updated by SAP during the day</span>
        <span style="margin-left:auto"></span>
        <button class="btn-sec btn-sm" @onclick="RefreshAsync" disabled="@_busy">↻ Refresh</button>
        <label class="btn-pri btn-sm" style="cursor:pointer;margin:0" data-testid="mra-upload-label">
            ⬆ Upload morning file
            <InputFile OnChange="OnFile" accept=".xlsx,.xls,.csv" style="display:none" disabled="@_busy" data-testid="mra-file" />
        </label>
    </div>
    <div style="padding:12px 18px">
        @if (_summary == null)
        {
            <div class="pf-empty">Loading…</div>
        }
        else if (!_summary.Available)
        {
            <div class="pf-note">MRA status is not available: @_summary.UnavailableReason</div>
        }
        else
        {
            var s = _summary.Summary;
            <div style="font-size:12px;color:var(--ink2);margin-bottom:8px" data-testid="mra-info">
                <strong>@s.Lines.ToString("N0")</strong> line(s) in <strong>@s.Mras.ToString("N0")</strong> MRA(s) · qty <strong>@s.Qty.ToString("N0")</strong>
                · morning file:
                @if (s.LastUploadAt is { } at)
                {
                    <span><strong>@s.LastUploadFile</strong> (@s.LastUploadRows?.ToString("N0") rows: @(s.LastUploadCreated ?? 0) new, @(s.LastUploadUpdated ?? 0) changed) by @s.LastUploadBy, @Fmt.When(at.ToString("o"))</span>
                }
                else
                {
                    <span>not uploaded yet</span>
                }
                · SAP changes today: <strong>@s.SapChangesToday.ToString("N0")</strong>@(s.LastSapChangeAt is { } l ? " (last " + Fmt.When(l.ToString("o")) + ")" : "")
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px">
                <button class="mra-chip @(_status == null ? "on" : "")" @onclick="() => FilterAsync(null)">All · @s.Lines.ToString("N0")</button>
                @foreach (var c in s.ByStatus)
                {
                    var st = c.Status;
                    <button class="mra-chip @(_status == st ? "on" : "")" @onclick="() => FilterAsync(st)" data-testid="mra-chip-@st">
                        @st · @c.Lines.ToString("N0") line@(c.Lines == 1 ? "" : "s") · qty @c.Qty.ToString("N0")
                    </button>
                }
            </div>
        }

        @if (_upload != null)
        {
            <div class="pf-note" style="border-left:3px solid @(_upload.Ok ? "#00873E" : "#DC2626");padding-left:10px" data-testid="mra-upload-result">
                @if (_upload.Ok)
                {
                    <div><strong>✔ @_upload.FileName</strong>: @_upload.Rows.ToString("N0") line(s) merged — @_upload.Created.ToString("N0") new,
                        @_upload.Updated.ToString("N0") changed, @_upload.Unchanged.ToString("N0") unchanged@(_upload.Ambiguous > 0 ? ", " + _upload.Ambiguous.ToString("N0") + " skipped" : "") · @_upload.UploadId
                        @(_upload.SkippedEmpty > 0 ? " · " + _upload.SkippedEmpty + " empty row(s) skipped" : "")</div>
                    @foreach (var w in _upload.Warnings)
                    {
                        <div style="font-size:12px;color:#B45309">⚠ @w</div>
                    }
                }
                else
                {
                    <div><strong>✖ @_upload.FileName was not loaded — the MRA data is unchanged.</strong></div>
                    <ul style="margin:4px 0 0 18px">
                        @foreach (var e in _upload.Errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
                @if (_upload.Columns.Count > 0)
                {
                    <div style="font-size:11px;color:var(--ink3);margin-top:4px">Columns used: @string.Join(" · ", _upload.Columns.Select(kv => kv.Key + " → " + kv.Value))</div>
                }
            </div>
        }

        <div class="pf-row" style="margin:6px 0">
            <input class="pf-in" style="min-width:260px;border:1px solid var(--brd);border-radius:6px;padding:6px 9px" placeholder="Search MRA No, article, colour, vendor…" @bind="_search" @bind:event="oninput"
                   @onkeyup="SearchKey" data-testid="mra-search" />
            <button class="btn-sec btn-sm" @onclick="() => LoadAsync(1)">Search</button>
            <span class="pf-count">@(_list?.Total.ToString("N0") ?? "0") line(s)</span>
        </div>

        @if (_list is { Items.Count: > 0 })
        {
            <div style="overflow-x:auto">
                <table class="ds-tbl" data-testid="mra-table">
                    <thead><tr><th>MRA No</th><th>Generic article</th><th>Colour</th><th>MC</th><th>MRP</th><th style="text-align:right">Qty</th><th>Status</th><th>Level</th><th>Delivery</th><th>Source</th><th>Updated</th></tr></thead>
                    <tbody>
                        @foreach (var l in _list.Items)
                        {
                            var no = l.MraNo;
                            <tr>
                                <td><a href="javascript:void(0)" @onclick="() => HistoryAsync(no)" title="SAP changes of this MRA">@l.MraNo</a></td>
                                <td>@l.GenericArticle<div style="font-size:10.5px;color:var(--ink3)">@l.GenericArtDesc</div></td>
                                <td>@l.Colour</td>
                                <td>@l.McCode</td>
                                <td>@l.Mrp?.ToString("0.##")</td>
                                <td style="text-align:right">@l.Qty.ToString("N0")</td>
                                <td><strong>@l.Status</strong></td>
                                <td>@l.ApprovalLevel</td>
                                <td>@l.DeliveryDate?.ToString("dd-MM-yyyy")</td>
                                <td>@(l.Source == "SAP" ? "SAP" : "File")</td>
                                <td class="pf-nowrap">@(l.UpdatedAt is { } u ? Fmt.When(u.ToString("o")) : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_list.Total > _list.PageSize)
            {
                var pages = (_list.Total + _list.PageSize - 1) / _list.PageSize;
                <div class="pf-row" style="margin-top:6px">
                    <button class="btn-sec btn-sm" disabled="@(_list.Page <= 1)" @onclick="() => LoadAsync(_list.Page - 1)">‹ Previous</button>
                    <span class="pf-count">page @_list.Page of @pages</span>
                    <button class="btn-sec btn-sm" disabled="@(_list.Page >= pages)" @onclick="() => LoadAsync(_list.Page + 1)">Next ›</button>
                </div>
            }
        }
        else if (_summary?.Available == true)
        {
            <div class="pf-empty">No MRA lines@(_status != null || !string.IsNullOrEmpty(_search) ? " match" : " yet — upload the morning file").</div>
        }

        @if (_history != null)
        {
            <div class="card" style="padding:10px 14px;margin-top:10px;border-left:4px solid var(--vmm-pink)" data-testid="mra-history">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <strong>MRA @_history.MraNo — changes (SAP and morning files)</strong>
                    <button class="btn-sec btn-sm" style="margin-left:auto" @onclick="() => _history = null">Close</button>
                </div>
                @if (_history.Items.Count == 0)
                {
                    <div class="pf-empty">No change recorded yet.</div>
                }
                else
                {
                    <table class="ds-tbl">
                        <thead><tr><th>Received</th><th>Changed in SAP</th><th>Line</th><th>Action</th><th>Status</th><th style="text-align:right">Qty</th><th>By</th></tr></thead>
                        <tbody>
                            @foreach (var h in _history.Items)
                            {
                                <tr>
                                    <td class="pf-nowrap">@Fmt.When(h.ReceivedAt.ToString("o"))</td>
                                    <td class="pf-nowrap">@(h.ChangedAt is { } c ? Fmt.When(c.ToString("o")) : "—")</td>
                                    <td>@(string.IsNullOrEmpty(h.GenericArticle) ? "—" : h.GenericArticle) / @(string.IsNullOrEmpty(h.Colour) ? "—" : h.Colour)</td>
                                    <td>@h.Action</td>
                                    <td>@(h.OldStatus == null ? "" : h.OldStatus + " → ")<strong>@h.NewStatus</strong></td>
                                    <td style="text-align:right">@(h.OldQty is { } oq && oq != h.NewQty ? oq.ToString("N0") + " → " : "")@h.NewQty.ToString("N0")</td>
                                    <td>@h.TechUser@(h.SourceSystem == "FILE" ? " (file)" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        <div style="font-size:11px;color:var(--ink3);margin-top:10px">
            Morning file: Excel or CSV, one row per MRA line. <strong>Required: MRA No (or MRN No), Qty (or PO Qty), Status (or Decision)</strong>;
            optional: Generic Art Cd, Generic Art Desc, Colour, Vendor Cd / Name, Brand Type, MC CODE / NAME, MRP, Planning flag, Fit, Design,
            Style, Fabric, Product material, PO Val, Delivery date, Level (Waiting for approval). Statuses: @string.Join(", ", _summary?.Statuses ?? new()).
            Uploading <strong>merges</strong> the file: its lines are added or updated (Qty, Status and every filled cell); lines that are not in the file stay as they are.
            A file with any wrong row is refused as a whole.
        </div>
    </div>
</div>

@code {
    private MraSummaryResponse? _summary;
    private MraListResponse? _list;
    private MraUploadResponse? _upload;
    private MraHistoryResponse? _history;
    private string? _status;
    private string _search = "";
    private bool _busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        var res = await ApiMasterService.MraSummaryAsync();
        if (res.IsSuccess && res.Data != null) _summary = res.Data;
        else { Snackbar.Warn(res.responseMessage); _summary ??= new MraSummaryResponse(); }
        if (_summary.Available) await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        var res = await ApiMasterService.MraListAsync(new MraListReq { Status = _status, Search = _search, Page = page, PageSize = 100 });
        if (res.IsSuccess && res.Data != null) _list = res.Data;
        else Snackbar.Warn(res.responseMessage);
    }

    private async Task FilterAsync(string? status)
    {
        _status = status;
        await LoadAsync(1);
    }

    private async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync(1);
    }

    private async Task HistoryAsync(string mraNo)
    {
        var res = await ApiMasterService.MraHistoryAsync(mraNo);
        if (res.IsSuccess && res.Data != null) _history = res.Data;
        else Snackbar.Warn(res.responseMessage);
    }

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var f = e.File;
        _busy = true;
        _upload = null;
        try
        {
            await using var stream = f.OpenReadStream(DataSetupText.MaxUploadBytes);
            var res = await ApiMasterService.MraUploadAsync(new ApiUploadFile(f.Name, stream, string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType));
            if (!res.IsSuccess || res.Data == null) { Snackbar.Warn(res.responseMessage); return; }
            _upload = res.Data;
            if (_upload.Ok) Snackbar.Toast($"MRA file merged — {_upload.Created:N0} new, {_upload.Updated:N0} changed");
            else Snackbar.Warn("MRA file refused — see the list below");
            _status = null;
            await RefreshAsync();
        }
        catch (IOException ex)
        {
            Snackbar.Warn(ex.Message);
        }
        finally { _busy = false; }
    }
}
