@* users.js renderScr / saveScr: which SCR columns hold buyer / category head e-mails, and the people found. *@
@inject IAPICallService Api
@inject ISnackbar Snackbar

@if (_error != null)
{
    <div class="card pf-err">@_error</div>
}
else if (_d == null)
{
    <div class="pf-empty">Loading…</div>
}
else if (!_d.HasScr)
{
    <div class="card" style="padding:30px;line-height:1.7">No SCR products file on the server yet. Upload it in <strong>Data Setup → SCR Products / Cat Head Mapping</strong> (or inside the ZIP bundle). Logins for its buyers and category heads are then created automatically, and you can fine-tune which columns are used here.</div>
}
else
{
    var cols = _d.Analysis.Columns;
    var newPeople = _d.People.Count(p => !p.Exists);
    <div class="card" style="padding:16px 18px;margin-bottom:12px">
        <div style="font-weight:700;margin-bottom:4px">Which columns hold whose email?</div>
        <div style="font-size:11.5px;color:var(--ink2);margin-bottom:10px">Found @cols.Count email column(s) in the current SCR file (@Fmt.N(_d.ScrRows) rows). Division heads are skipped for now. Existing users are never removed or demoted.</div>
        <PfTable Headers="ColHeaders" Count="cols.Count" Empty="No column with email addresses found in the SCR file.">
            @foreach (var c in cols)
            {
                var col = c.Column;
                <tr>
                    <td><strong>@c.Column</strong></td>
                    <td style="font-size:11px;color:var(--ink3)">@c.Example</td>
                    <td class="pf-mono">@c.DistinctEmails</td>
                    <td>
                        <select class="pf-in" value="@_map[col]" @onchange="e => _map[col] = e.Value?.ToString() ?? string.Empty" data-testid="scr-map">
                            @foreach (var o in Options)
                            {
                                <option value="@o.Key" selected="@(_map[col] == o.Key)">@o.Label</option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </PfTable>
        <div style="display:flex;gap:10px;align-items:center;margin-top:12px">
            <span style="font-size:12px;color:var(--ink2)">With the current settings: <strong>@_d.People.Count</strong> people, <strong>@newPeople</strong> new.</span>
            <button class="btn-pri" style="margin-left:auto" disabled="@_busy" @onclick="SaveAsync">Save &amp; create logins</button>
        </div>
    </div>
    <PfTable Headers="PeopleHeaders" Count="_d.People.Count" Empty="Nobody found with these settings.">
        @foreach (var p in _d.People)
        {
            <tr>
                <td><strong>@(string.IsNullOrEmpty(p.Name) ? "—" : p.Name)</strong><div style="font-size:11px;color:var(--ink3)">@p.Email</div></td>
                <td><RoleChips Roles="p.Roles" Labels="ScrLabels" /></td>
                <td class="pf-mono">@p.Mcs</td>
                <td>
                    @if (p.Exists)
                    {
                        <span style="color:#00873E">✓ exists</span>
                    }
                    else
                    {
                        <span style="color:#B45309">will be created</span>
                    }
                </td>
            </tr>
        }
    </PfTable>
}

@code {
    private static readonly string[] ColHeaders = { "Column in SCR file", "Example value", "Distinct emails", "Treat as" };
    private static readonly string[] PeopleHeaders = { "Person", "Role(s) from SCR", "MCs", "Login" };
    private static readonly (string Key, string Label)[] Options = { ("buyer", "Buyer"), ("cathead", "Category Head"), ("skip", "Skip (e.g. Division Head)") };
    private static readonly Dictionary<string, string> ScrLabels = new() { ["buyer"] = "Buyer", ["cathead"] = "Category Head" };

    private ScrOverviewResponse? _d;
    private string? _error;
    private bool _busy;
    private Dictionary<string, string> _map = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var res = await Api.GetScrAsync();
        if (!res.IsSuccess || res.Data == null) { _error = res.ResponseMessage; return; }
        _error = null;
        _d = res.Data;
        var saved = _d.Mapping?.Columns ?? new Dictionary<string, string>();
        _map = _d.Analysis.Columns.ToDictionary(c => c.Column, c => saved.TryGetValue(c.Column, out var v) && !string.IsNullOrEmpty(v) ? v : c.Guess);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var res = await Api.SaveScrMappingAsync(new Dictionary<string, string>(_map));
            if (!res.IsSuccess || res.Data == null) { Snackbar.Warn(res.ResponseMessage); return; }
            Snackbar.Toast("Created " + res.Data.Result.Added.Count + " login(s), updated " + res.Data.Result.Updated.Count);
            await LoadAsync();
        }
        finally { _busy = false; }
    }
}
