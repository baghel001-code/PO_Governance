@* Data Setup → MRA file (v1.1.7). One workbook, two sheets (item lines + header report); each upload REPLACES the MRA list
   (PO_MRA_UPLOAD). During the day SAP sends the changes to POST /api/sap/v1/mra-events and /po-events. Levels 1, 2 and 4
   (and level 5 reached live today) count against the colour capacity of single concept articles. *@
@using DecisionEngine.Results.Mra
@using Admin.Services.Platform
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PlatformStyles />

<div class="ds-card" data-testid="mra-panel">
    <div class="ds-card-hdr" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span>📦 MRA – SAP Merchandise Requests</span>
        <span style="font-weight:400;opacity:.8;font-size:11.5px">morning file here · live changes from SAP during the day</span>
        <span style="margin-left:auto"></span>
        <button class="btn-sec btn-sm" @onclick='() => Nav.NavigateTo("/mra")'>📦 MRA Queues</button>
        <button class="btn-sec btn-sm" @onclick="RefreshAsync" disabled="@_busy">↻ Refresh</button>
        <label class="btn-pri btn-sm" style="cursor:pointer;margin:0" data-testid="mra-upload-label">
            @(_busy ? "Reading…" : "⬆ Upload MRA file")
            <InputFile OnChange="OnFile" accept=".xlsx,.xlsb,.xls" style="display:none" disabled="@_busy" data-testid="mra-file" />
        </label>
    </div>
    <div style="padding:12px 18px;font-size:12px">
        @if (_state == null)
        {
            <div class="pf-empty">Loading…</div>
        }
        else if (!_state.Available)
        {
            <div class="pf-note">SAP MRAs are not available: @_state.UnavailableReason</div>
        }
        else
        {
            var snap = _state.Snapshot;
            var counted = _state.Rows.Where(r => r.C.Counted).ToList();
            <div data-testid="mra-info" style="color:var(--ink2);line-height:1.7">
                @if (snap != null)
                {
                    <span>MRA file <strong>@snap.FileName</strong> · @snap.MraCount.ToString("N0") MRAs · loaded @Fmt.When(snap.UploadedAt.ToString("o")) by @snap.By</span>
                }
                else
                {
                    <span>No MRA file loaded yet.</span>
                }
                · counted against capacity now: <strong>@counted.Count.ToString("N0") MRAs · @counted.Sum(r => r.M.Qty).ToString("N0") pcs</strong>
                · live messages since the file: <strong>@_state.Log.Count.ToString("N0")</strong>
                · Tool requests use capacity: <strong>@(_state.Switches.ToolReqCapacity ? "ON" : "OFF")</strong>
            </div>
        }

        @if (_upload != null)
        {
            <div class="pf-note" style="margin-top:8px;border-left:3px solid @(_upload.Ok ? "#00873E" : "#DC2626");padding-left:10px" data-testid="mra-upload-result">
                @if (_upload.Ok)
                {
                    <div>
                        <strong>✓ MRA file loaded: @_upload.Mras.ToString("N0") MRAs</strong>
                        (@string.Join(" · ", _upload.ByLevel.Select(kv => "L" + kv.Key + ": " + kv.Value.ToString("N0"))))
                        from sheets “@_upload.ItemSheet” and “@_upload.HeaderSheet”.
                    </div>
                    <div>
                        Counted against capacity now: <strong>@_upload.CountedMras.ToString("N0") MRAs · @_upload.CountedQty.ToString("N0") pcs</strong>
                        (levels 1, 2, 4, delivery date not passed, single concept, in Article Master). This replaces the previous MRA list.
                        @if (_upload.Decisions > 0 || _upload.DecisionsKept > 0)
                        {
                            <span> Decisions in the file: @_upload.Decisions; kept from SAP messages: @_upload.DecisionsKept.</span>
                        }
                    </div>
                    @foreach (var w in _upload.Warnings)
                    {
                        <div style="color:#8A5A00">⚠ @w</div>
                    }
                }
                else
                {
                    <div><strong>✗ MRA file not loaded.</strong> @_upload.Error</div>
                }
            </div>
        }

        <div style="font-size:11px;color:var(--ink3);margin-top:10px;line-height:1.6">
            One workbook, two sheets (any names): the <strong>item lines</strong> (DOC.NO, ARTICLE CODE, Color, Generic Article, TOTAL PO QTY,
            DEL. DATE, LEVEL; CREATED BY) and the <strong>header report</strong> “Report For Merchandise Request” (Document Number, Purchase order,
            Status; Po Date, Created By, Inspiration). Upload the full file every morning (all levels 1–9, X): it replaces the previous MRA list;
            SAP's live changes received from today on are applied on top. Brand, MC, MRP and Flag come from the Article Master.
        </div>
    </div>
</div>

@code {
    private MraStateResponse? _state;
    private MraUploadResponse? _upload;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        var res = await ApiMasterService.MraStateAsync();
        if (res.IsSuccess && res.Data != null) _state = res.Data;
        else { Snackbar.Warn(res.responseMessage); _state ??= new MraStateResponse { Available = false, UnavailableReason = res.responseMessage }; }
    }

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var f = e.File;
        _busy = true;
        _upload = null;
        StateHasChanged();
        try
        {
            await using var stream = f.OpenReadStream(DataSetupText.MaxUploadBytes);
            var res = await ApiMasterService.MraUploadAsync(new ApiUploadFile(f.Name, stream, string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType));
            if (!res.IsSuccess || res.Data == null) { Snackbar.Warn(res.responseMessage); return; }
            _upload = res.Data;
            if (_upload.Ok) Snackbar.Toast($"MRA file loaded — {_upload.Mras:N0} MRAs, {_upload.CountedMras:N0} counted");
            else Snackbar.Warn("MRA file not loaded — see the message below");
            await RefreshAsync();
        }
        catch (IOException ex)
        {
            Snackbar.Warn(ex.Message);
        }
        finally { _busy = false; }
    }
}
